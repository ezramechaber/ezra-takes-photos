{
  "name": "ezra-takes-photos",
  "version": "2.0.0",
  "description": "Photos, backed by Payload CMS.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "npm run generate:static-photos && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build && npm run package:figma-runtime",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:static-photos": "tsx scripts/build-static-photos.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/migrate-eleventy.ts",
    "build:redirects": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/build-redirects.ts",
    "lambda:buildzip": "npm run build && npx payloadcms-figma build-lambda-zip",
    "package:figma-runtime": "node scripts/package-figma-runtime.mjs"
  },
  "dependencies": {
    "@payloadcms/figma": "0.1.0-alpha.6",
    "@payloadcms/live-preview-react": "4.0.0-canary.29",
    "@payloadcms/next": "4.0.0-canary.29",
    "@payloadcms/payload-cloud": "4.0.0-canary.29",
    "@payloadcms/plugin-cloud-storage": "4.0.0-canary.29",
    "@payloadcms/plugin-mcp": "4.0.0-canary.29",
    "@payloadcms/richtext-lexical": "4.0.0-canary.29",
    "@payloadcms/ui": "4.0.0-canary.29",
    "cross-env": "^7.0.3",
    "exifr": "^7.1.3",
    "graphql": "^16.8.1",
    "next": "16.3.0",
    "payload": "4.0.0-canary.29",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
