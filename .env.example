# Payload Cloud injects DATABASE_URI in production.
# Locally, point at the docker-compose mongo:
DATABASE_URI=mongodb://127.0.0.1/ezra-takes-photos

# Any long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public origin of the site. Used for live preview URLs and og: tags.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Shared secret guarding the draft-preview route. Generate with: openssl rand -hex 32
PREVIEW_SECRET=
